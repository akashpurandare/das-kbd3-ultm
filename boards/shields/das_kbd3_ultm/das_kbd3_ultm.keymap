// Das Keyboard 3.0 Ultimate — ZMK keymap
// 104-key ANSI layout matching the matrix transform in das_kbd3_ultm.overlay
// Key order follows default_transform rows top-to-bottom.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // ── R0: ESC     -        F4       -        F6       -        F11      LAlt     G        H        '        Space    -        -        KP0      Up       KP.      -
                   &kp ESC   &none     &kp F4    &none     &kp F6    &none     &kp F11   &kp LALT  &kp G     &kp H     &kp SQT   &kp SPACE &none     &none     &kp KP_N0 &kp UP    &kp KP_DOT &none
                // ── R1: N1      N2       N3       F5       N8       N9       F10      PrtSc    N4       N7       N0       -        -        -        -        End      PgDn     -
                   &kp N1    &kp N2    &kp N3    &kp F5    &kp N8    &kp N9    &kp F10   &kp PSCRN &kp N4    &kp N7    &kp N0    &none     &none     &none     &none     &kp END   &kp PG_DN  &none
                // ── R2: `       F1       F2       LCtrl    =        F8       F9       -        N5       N6       -        Del      -        -        Ins      Home     PgUp     -
                   &kp GRAVE &kp F1    &kp F2    &kp LCTRL &kp EQUAL &kp F8    &kp F9    &none     &kp N5    &kp N6    &kp MINUS &kp DEL   &none     &none     &kp INS   &kp HOME  &kp PG_UP  &none
                // ── R3: A       S        D        -        K        L        \        -        F        J        ;        KP1      RShft    -        KP2      KPEnt    KP3      RWin
                   &kp A     &kp S     &kp D     &none     &kp K     &kp L     &kp BSLH  &none     &kp F     &kp J     &kp SEMI  &kp KP_N1 &kp RSHFT &none     &kp KP_N2 &kp KP_ENTER &kp KP_N3 &kp RGUI
                // ── R4: Tab     Caps     F3       -        ]}       F7       BkSp     -        T        Y        [{       KP4      LShft    LWin     KP5      -        KP6      -
                   &kp TAB   &kp CAPS  &kp F3    &none     &kp RBKT  &kp F7    &kp BSPC  &none     &kp T     &kp Y     &kp LBKT  &kp KP_N4 &kp LSHFT &kp LGUI  &kp KP_N5 &none     &kp KP_N6  &none
                // ── R5: Q       W        E        Pause    I        O        -        ScLk     R        U        P        KP7      -        -        KP8      KP+      KP9      -
                   &kp Q     &kp W     &kp E     &kp PAUSE_BREAK &kp I &kp O   &none     &kp SLCK  &kp R     &kp U     &kp P     &kp KP_N7 &none     &none     &kp KP_N8 &kp KP_PLUS &kp KP_N9 &none
                // ── R6: Z       X        C        RCtrl    ,        .        Enter    -        V        M        -        NumLk    -        -        KP/      -        KP*      -
                   &kp Z     &kp X     &kp C     &kp RCTRL &kp COMMA &kp DOT   &kp RET   &none     &kp V     &kp M     &none     &kp KP_NUM &none    &none     &kp KP_SLASH &none   &kp KP_MULTIPLY &none
                // ── R7: -       -        -        -        -        Apps     F12      RAlt     B        N        /?       Down     -        -        Right    Left     KP-      -
                   &none     &none     &none     &none     &none     &kp K_APP &kp F12   &kp RALT  &kp B     &kp N     &kp FSLH  &kp DOWN  &none     &none     &kp RIGHT &kp LEFT  &kp KP_MINUS &none
            >;
        };
    };
};
