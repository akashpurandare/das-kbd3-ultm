// Das Keyboard 3.0 Ultimate — ZMK keymap
// 104-key ANSI layout matching the matrix transform in das_kbd3_ultm.overlay
// Key order follows default_transform rows top-to-bottom.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                // ── Function row (16) ──────────────────────────────────────────────────────
                &kp ESC      &kp F1       &kp F2       &kp F3       &kp F4       &kp F5       &kp F6       &kp F7       &kp F8
                &kp F9       &kp F10      &kp F11      &kp F12      &kp PSCRN    &kp SLCK     &kp PAUSE_BREAK

                // ── Number row (14) ────────────────────────────────────────────────────────
                &kp GRAVE    &kp N1       &kp N2       &kp N3       &kp N4       &kp N5       &kp N6       &kp N7
                &kp N8       &kp N9       &kp N0       &kp MINUS    &kp EQUAL    &kp BSPC

                // ── QWERTY row (14) ────────────────────────────────────────────────────────
                &kp TAB      &kp Q        &kp W        &kp E        &kp R        &kp T        &kp Y        &kp U
                &kp I        &kp O        &kp P        &kp LBKT     &kp RBKT     &kp BSLH

                // ── Home row (13) ──────────────────────────────────────────────────────────
                &kp CAPS     &kp A        &kp S        &kp D        &kp F        &kp G        &kp H        &kp J
                &kp K        &kp L        &kp SEMI     &kp SQT      &kp RET

                // ── Shift row (12) ─────────────────────────────────────────────────────────
                &kp LSHFT    &kp Z        &kp X        &kp C        &kp V        &kp B        &kp N        &kp M
                &kp COMMA    &kp DOT      &kp FSLH     &kp RSHFT

                // ── Bottom row (8) ─────────────────────────────────────────────────────────
                &kp LCTRL    &kp LGUI     &kp LALT     &kp SPACE    &kp RALT     &kp RGUI     &kp K_APP    &kp RCTRL

                // ── Navigation cluster (10) ────────────────────────────────────────────────
                &kp INS      &kp HOME     &kp PG_UP    &kp UP
                &kp DEL      &kp END      &kp PG_DN    &kp LEFT     &kp DOWN     &kp RIGHT

                // ── Numpad (17) ────────────────────────────────────────────────────────────
                &kp KP_NUM   &kp KP_SLASH &kp KP_MULTIPLY &kp KP_MINUS
                &kp KP_N7    &kp KP_N8    &kp KP_N9    &kp KP_PLUS
                &kp KP_N4    &kp KP_N5    &kp KP_N6
                &kp KP_N1    &kp KP_N2    &kp KP_N3    &kp KP_ENTER
                &kp KP_N0                 &kp KP_DOT
            >;
        };
    };
};
