// Das Keyboard 3.0 Ultimate — ZMK shield overlay
// Controller: Pro Micro nRF52840 v2.0 (Nice!Nano compatible)
// Matrix: 18 columns × 8 rows, col2row, diodes per switch
// GPIO expansion: 2× MCP23017 on I²C (0x20, 0x21)
// IDC connector: 26-pin 2×13, 2.54mm pitch

#include <dt-bindings/zmk/matrix_transform.h>

#include "das_kbd3_ultm.dtsi"

/ {
    chosen {
        zmk,physical-layout   = &default_layout;
        zephyr,display        = &ssd1306;        /* OLED enabled — fit 4.7 kΩ pull-ups on SDA+SCL to 3.3 V */
        zmk,led-indicators    = &leds;           /* lock LEDs  — requires CONFIG_ZMK_HID_INDICATORS=y */
        zmk,battery           = &max17048;       /* fuel gauge */
    };

    // -------------------------------------------------------------------------
    // Key scan — all GPIOs via MCP23017 over I²C
    //
    // Optimized IDC pin assignment — each MCP chip's GPIO pins map to IDC
    // pins in ascending numerical order, minimising ribbon-cable crossings:
    //
    // MCP23017 (0x20) — &mcp23017_20  (IDC pins 1–10, cols only):
    //   GPA0 (idx  0) → IDC  1  C4
    //   GPA1 (idx  1) → IDC  2  C7
    //   GPA2 (idx  2) → IDC  3  C5
    //   GPA3 (idx  3) → IDC  4  C9
    //   GPA4 (idx  4) → IDC  5  C8
    //   GPA5 (idx  5) → IDC  6  C2
    //   GPA6 (idx  6) → IDC  7  C1
    //   GPA7 (idx  7) → IDC  8  C0
    //   GPB0 (idx  8) → IDC  9  C3
    //   GPB1 (idx  9) → IDC 10  C6
    //   GPB2 (idx 10) → NumLk LED
    //   GPB3 (idx 11) → CapsLk LED
    //   GPB4 (idx 12) → ScrlLk LED
    //   GPB5–GPB7 n/c
    //
    // MCP23017 (0x21) — &mcp23017_21  (IDC pins 11–26, cols + rows):
    //   GPB0 (idx  8) → IDC 11  R0  (pull-down input)
    //   GPB1 (idx  9) → IDC 12  R1  (pull-down input)
    //   GPA0 (idx  0) → IDC 13  C14
    //   GPA1 (idx  1) → IDC 14  C10
    //   GPA2 (idx  2) → IDC 15  C11
    //   GPB2 (idx 10) → IDC 16  R2  (pull-down input)
    //   GPB3 (idx 11) → IDC 17  R3  (pull-down input)
    //   GPB4 (idx 12) → IDC 18  R4  (pull-down input)
    //   GPB5 (idx 13) → IDC 19  R5  (pull-down input)
    //   GPA3 (idx  3) → IDC 20  C16
    //   GPB6 (idx 14) → IDC 21  R6  (pull-down input)
    //   GPB7 (idx 15) → IDC 22  R7  (pull-down input)
    //   GPA4 (idx  4) → IDC 23  C17
    //   GPA5 (idx  5) → IDC 24  C13
    //   GPA6 (idx  6) → IDC 25  C12
    //   GPA7 (idx  7) → IDC 26  C15
    //
    // ZMK mcp230xx driver: pin index 0–7 = GPA0–GPA7, 8–15 = GPB0–GPB7
    // -------------------------------------------------------------------------
    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "col2row";
        wakeup-source;

        col-gpios
            = <&mcp23017_20 7 GPIO_ACTIVE_HIGH>   /* C0  - IDC pin  8  MCP0.GPA7 */
            , <&mcp23017_20 6 GPIO_ACTIVE_HIGH>   /* C1  - IDC pin  7  MCP0.GPA6 */
            , <&mcp23017_20 5 GPIO_ACTIVE_HIGH>   /* C2  - IDC pin  6  MCP0.GPA5 */
            , <&mcp23017_20 8 GPIO_ACTIVE_HIGH>   /* C3  - IDC pin  9  MCP0.GPB0 */
            , <&mcp23017_20 0 GPIO_ACTIVE_HIGH>   /* C4  - IDC pin  1  MCP0.GPA0 */
            , <&mcp23017_20 2 GPIO_ACTIVE_HIGH>   /* C5  - IDC pin  3  MCP0.GPA2 */
            , <&mcp23017_20 9 GPIO_ACTIVE_HIGH>   /* C6  - IDC pin 10  MCP0.GPB1 */
            , <&mcp23017_20 1 GPIO_ACTIVE_HIGH>   /* C7  - IDC pin  2  MCP0.GPA1 */
            , <&mcp23017_20 4 GPIO_ACTIVE_HIGH>   /* C8  - IDC pin  5  MCP0.GPA4 */
            , <&mcp23017_20 3 GPIO_ACTIVE_HIGH>   /* C9  - IDC pin  4  MCP0.GPA3 */
            , <&mcp23017_21 1 GPIO_ACTIVE_HIGH>   /* C10 - IDC pin 14  MCP1.GPA1 */
            , <&mcp23017_21 2 GPIO_ACTIVE_HIGH>   /* C11 - IDC pin 15  MCP1.GPA2 */
            , <&mcp23017_21 6 GPIO_ACTIVE_HIGH>   /* C12 - IDC pin 25  MCP1.GPA6 */
            , <&mcp23017_21 5 GPIO_ACTIVE_HIGH>   /* C13 - IDC pin 24  MCP1.GPA5 */
            , <&mcp23017_21 0 GPIO_ACTIVE_HIGH>   /* C14 - IDC pin 13  MCP1.GPA0 */
            , <&mcp23017_21 7 GPIO_ACTIVE_HIGH>   /* C15 - IDC pin 26  MCP1.GPA7 */
            , <&mcp23017_21 3 GPIO_ACTIVE_HIGH>   /* C16 - IDC pin 20  MCP1.GPA3 */
            , <&mcp23017_21 4 GPIO_ACTIVE_HIGH>   /* C17 - IDC pin 23  MCP1.GPA4 */
            ;

        row-gpios
            = <&mcp23017_21  8 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R0 - IDC pin 11  MCP1.GPB0 */
            , <&mcp23017_21  9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R1 - IDC pin 12  MCP1.GPB1 */
            , <&mcp23017_21 10 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R2 - IDC pin 16  MCP1.GPB2 */
            , <&mcp23017_21 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R3 - IDC pin 17  MCP1.GPB3 */
            , <&mcp23017_21 12 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R4 - IDC pin 18  MCP1.GPB4 */
            , <&mcp23017_21 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R5 - IDC pin 19  MCP1.GPB5 */
            , <&mcp23017_21 14 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R6 - IDC pin 21  MCP1.GPB6 */
            , <&mcp23017_21 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* R7 - IDC pin 22  MCP1.GPB7 */
            ;
    };

    // -------------------------------------------------------------------------
    // Matrix transform — 18 columns × 8 rows, 104 keys
    //
    // RC(row, col):
    //   col = index into col-gpios list above (0 = C0 … 17 = C17)
    //   row = index into row-gpios list above (0 = R0 … 7  = R7)
    //
    // Columns (col index):
    //   C0 (0) : ESC ` Tab 1 Q A Z
    //   C1 (1) : F1 2 W S X CapsLk
    //   C2 (2) : F2 F3 F4 3 E D C
    //   C3 (3) : F5 Pause LCtrl RCtrl
    //   C4 (4) : F6 8 I K , =+ ]}
    //   C5 (5) : F7 F8 9 O L . Apps
    //   C6 (6) : F9 F10 F11 F12 BkSpc \ Enter
    //   C7 (7) : PrtSc ScLk LAlt RAlt
    //   C8 (8) : 4 5 R T F G V B
    //   C9 (9) : 6 7 Y U H J N M
    //   C10(10): 0 - P [{ ' ; /?
    //   C11(11): Space NumLk Num7 Num4 Num1 Down Del
    //   C12(12): LShft RShft
    //   C13(13): LWin
    //   C14(14): Ins Right Num0 Num2 Num5 Num8 Num/
    //   C15(15): Home End Up Left Num+ NumEnt
    //   C16(16): PgUp PgDn Num* Num9 Num6 Num3 Num. Num-
    //   C17(17): RWin
    //
    // Rows (row index):
    //   R0(0): ESC F4 F6 F11 LAlt Space H G ' Up Num0 Num.
    //   R1(1): PrtSc F10 0 9 8 7 F5 4 3 2 1 PgDn End
    //   R2(2): PgUp Home Del Ins =+ -_ F9 F8 6 5 F2 F1 ` LCtrl
    //   R3(3): NumEnt Num3 Num2 Num1 RShft RWin \ ; L K J F D S A
    //   R4(4): Num5 Num6 Num4 BkSpc ]} [{ F7 T Y F3 Tab CapsLk LShft LWin
    //   R5(5): Num9 Num+ Num8 Num7 Pause ScLk P O I U R E W Q
    //   R6(6): Num/ NumLk Num* RCtrl V C X Z M , . Enter
    //   R7(7): Num- Right Down Left Apps /? RAlt N B F12
    // -------------------------------------------------------------------------
    default_transform: default_transform {
        compatible = "zmk,matrix-transform";
        columns = <18>;
        rows = <8>;

        map = <
        // ── Function row ─────────────────────────────────────────────────────────────────────────────
        // ESC       F1        F2        F3        F4        F5        F6        F7        F8
           RC(0,0)   RC(2,1)   RC(2,2)   RC(4,2)   RC(0,2)   RC(1,3)   RC(0,4)   RC(4,5)   RC(2,5)
        // F9        F10       F11       F12       PrtSc     ScLk      Pause
           RC(2,6)   RC(1,6)   RC(0,6)   RC(7,6)   RC(1,7)   RC(5,7)   RC(5,3)

        // ── Number row ───────────────────────────────────────────────────────────────────────────────
        // `         1         2         3         4         5         6         7
           RC(2,0)   RC(1,0)   RC(1,1)   RC(1,2)   RC(1,8)   RC(2,8)   RC(2,9)   RC(1,9)
        // 8         9         0         -         =         BkSpc
           RC(1,4)   RC(1,5)   RC(1,10)  RC(2,10)  RC(2,4)   RC(4,6)

        // ── QWERTY row ───────────────────────────────────────────────────────────────────────────────
        // Tab       Q         W         E         R         T         Y         U
           RC(4,0)   RC(5,0)   RC(5,1)   RC(5,2)   RC(5,8)   RC(4,8)   RC(4,9)   RC(5,9)
        // I         O         P         [{        ]}        \
           RC(5,4)   RC(5,5)   RC(5,10)  RC(4,10)  RC(4,4)   RC(3,6)

        // ── Home row ─────────────────────────────────────────────────────────────────────────────────
        // CapsLk    A         S         D         F         G         H         J
           RC(4,1)   RC(3,0)   RC(3,1)   RC(3,2)   RC(3,8)   RC(0,8)   RC(0,9)   RC(3,9)
        // K         L         ;         '         Enter
           RC(3,4)   RC(3,5)   RC(3,10)  RC(0,10)  RC(6,6)

        // ── Shift row ────────────────────────────────────────────────────────────────────────────────
        // LShft     Z         X         C         V         B         N         M
           RC(4,12)  RC(6,0)   RC(6,1)   RC(6,2)   RC(6,8)   RC(7,8)   RC(7,9)   RC(6,9)
        // ,         .         /?        RShft
           RC(6,4)   RC(6,5)   RC(7,10)  RC(3,12)

        // ── Bottom row ───────────────────────────────────────────────────────────────────────────────
        // LCtrl     LWin      LAlt                Space               RAlt      RWin      Apps      RCtrl
           RC(2,3)   RC(4,13)  RC(0,7)             RC(0,11)            RC(7,7)   RC(3,17)  RC(7,5)   RC(6,3)

        // ── Navigation cluster ────────────────────────────────────────────────────────────────────────
        // Ins       Home      PgUp                Up
           RC(2,14)  RC(2,15)  RC(2,16)            RC(0,15)
        // Del       End       PgDn      Left      Down      Right
           RC(2,11)  RC(1,15)  RC(1,16)  RC(7,15)  RC(7,11)  RC(7,14)

        // ── Numpad ───────────────────────────────────────────────────────────────────────────────────
        // NumLk     Num/      Num*      Num-
           RC(6,11)  RC(6,14)  RC(6,16)  RC(7,16)
        // Num7      Num8      Num9      Num+
           RC(5,11)  RC(5,14)  RC(5,16)  RC(5,15)
        // Num4      Num5      Num6
           RC(4,11)  RC(4,14)  RC(4,16)
        // Num1      Num2      Num3      NumEnt
           RC(3,11)  RC(3,14)  RC(3,16)  RC(3,15)
        // Num0                Num.
           RC(0,14)            RC(0,16)
        >;
    };

    // -------------------------------------------------------------------------
    // HID lock-state indicator LEDs
    //
    // Mapped to MCP23017 (0x20) port B:
    //   GPB2 (pin index 10) → Num Lock    (IDC col range ends at GPB1=idx9; GPB2 is next free)
    //   GPB3 (pin index 11) → Caps Lock
    //   GPB4 (pin index 12) → Scroll Lock
    //
    // ZMK maps these in HID indicator order (0=NumLk 1=CapsLk 2=ScrlLk)
    // matching the USB HID spec. Requires CONFIG_ZMK_HID_INDICATORS=y.
    // -------------------------------------------------------------------------
    leds: leds {
        compatible = "gpio-leds";
        led_num_lock: led_num_lock {
            gpios = <&mcp23017_20 10 GPIO_ACTIVE_HIGH>;
            label = "Num Lock LED";
        };
        led_caps_lock: led_caps_lock {
            gpios = <&mcp23017_20 11 GPIO_ACTIVE_HIGH>;
            label = "Caps Lock LED";
        };
        led_scroll_lock: led_scroll_lock {
            gpios = <&mcp23017_20 12 GPIO_ACTIVE_HIGH>;
            label = "Scroll Lock LED";
        };
    };

    // -------------------------------------------------------------------------
    // Bootloader integration
    //
    // 1. Physical boot button — wire a momentary switch between P0.22 (Pro
    //    Micro D4) and GND.  In the keymap bind a combo to &bootloader.
    //    Change the GPIO if a different pin is physically connected.
    //
    // 2. Soft power-off waker — lets the keyboard matrix wake the MCU from
    //    ZMK software power-off (CONFIG_ZMK_PM_SOFT_OFF=y).  Required for
    //    the BLE sleep/wake cycle on battery-powered builds.
    // -------------------------------------------------------------------------
    boot_button: boot_button {
        compatible = "gpio-keys";
        status = "okay";
        boot_key: boot_key {
            label = "Bootloader Key";
            gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan>;
    };
};

// -------------------------------------------------------------------------
// I²C bus — MCP23017 GPIO expanders, OLED, fuel gauge
//
// Pin assignment (nice_nano_v2 Pro Micro footprint):
//   SDA  →  P0.17  (Pro Micro D2)   — defined in board's i2c0_default pinctrl
//   SCL  →  P0.20  (Pro Micro D3)   — defined in board's i2c0_default pinctrl
//
// If using a custom nRF52840 board that does NOT pre-define i2c0_default,
// add a &pinctrl block here:
//
//   #include <dt-bindings/pinctrl/nrf-pinctrl.h>
//   &pinctrl {
//       i2c0_default: i2c0_default {
//           group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
//                            <NRF_PSEL(TWIM_SCL, 0, 20)>; bias-pull-up; }; };
//       i2c0_sleep: i2c0_sleep {
//           group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
//                            <NRF_PSEL(TWIM_SCL, 0, 20)>; low-power-enable; }; };
//   };
//
// Bus devices:  mcp23017@20, mcp23017@21, ssd1306@3c (128×32), max17048@36
// 4.7 kΩ pull-ups on SDA/SCL to 3.3 V required on the PCB (also re-enables OLED).
//
// MCP23017 interrupt wiring — one dedicated INT line per chip:
//
//   Each chip: IOCON.MIRROR=1 (INTA mirrors INTB, full 16-pin coverage from one pin)
//              IOCON.ODR=1    (open-drain INT output)
//   Fit one 4.7 kΩ pull-up resistor from each INT line to 3.3 V on the PCB.
//   The nRF52840 GPIO is configured without an internal pull-up (GPIO_ACTIVE_LOW only).
//
//   mcp23017@20  INTB ──── D5  / P0.24  (gpio0 pin 24)  — 4.7kΩ ext. pull-up to 3.3V on PCB
//   mcp23017@21  INTB ──── D6  / P1.00  (gpio1 pin  0)  — 4.7kΩ ext. pull-up to 3.3V on PCB
//
//   MCP0 GPA=cols, GPB0-1=cols, GPB2-4=LED outputs — INT will only assert if
//   GPB2-4 are configured as inputs (they are not).  MCP0 INT line is kept for
//   symmetry and potential future expansion.
//   MCP1 GPB pins are pull-down row inputs — INT asserts low on each keypress,
//   waking the nRF and triggering interrupt-driven kscan via int-gpios.
//
// -------------------------------------------------------------------------
&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <400000>;   /* 400 kHz fast-mode — 4 devices, keep bus fast */

    mcp23017_20: mcp23017@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        int-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;  /* INTB → D5/P0.24; IOCON.MIRROR=1; 4.7kΩ ext. pull-up to 3.3V */
        /* A2=0 A1=0 A0=0 → 0x20 */
    };

    mcp23017_21: mcp23017@21 {
        compatible = "microchip,mcp23017";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        ngpios = <16>;
        int-gpios = <&gpio1 0 GPIO_ACTIVE_LOW>;   /* INTB → D6/P1.00; IOCON.MIRROR=1; 4.7kΩ ext. pull-up to 3.3V */
        /* A2=0 A1=0 A0=1 → 0x21 */
    };

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306fb";
        status = "okay";         /* 4.7 kΩ pull-ups on SDA+SCL to 3.3 V must be fitted on the PCB */
        reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;  /* 32 rows − 1 */
        prechargep = <0x22>;
        com-invdir;              /* COM scan direction: remapped (top→bottom for
                                    DFRobot Fermion 0.91″ module)              */
    };

    max17048: max17048@36 {
        compatible = "zmk,maxim-max17048";
        reg = <0x36>;
    };
};
