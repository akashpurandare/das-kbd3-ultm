// Das Keyboard 3.0 Ultimate — ZMK shield overlay
// Controller: Pro Micro nRF52840 v2.0 (Nice!Nano compatible)
// Matrix: 18 columns × 8 rows, row2col, diodes per switch
// GPIO expansion: 2× MCP23017 on I²C (0x20, 0x21)
// IDC connector: 26-pin 2×13, 2.54mm pitch

#include <dt-bindings/zmk/matrix_transform.h>
#include <dt-bindings/zmk/hid_indicators.h>

#include "das_kbd3_ultm.dtsi"

/ {
    chosen {
        zmk,physical-layout   = &default_layout;
      // zephyr,display     = &ssd1306;        /* TEMPORARILY DISABLED — OLED disconnected */
      // zmk,battery         = &max17048;       /* TEMPORARILY DISABLED — MAX17048 disconnected */
    };

    // -------------------------------------------------------------------------
    // Key scan — MCP23017 #0 = 16 columns (C0–C11, C13, C14, C16, C17), MCP23017 #1 = 8 rows
    //             C12 and C15 connect directly to nRF52840 GPIO with ext. 10 kΩ pull-down
    //
    // ZMK mcp23xxx driver: pin index 0–7 = GPA0–GPA7, 8–15 = GPB0–GPB7
    //
    // MCP23017 (0x20) — &mcp23017_20  (cols C0–C11, C13, C14, C16, C17 — scrambled routing):
    //   GPA7 (idx  7) → C0  → IDC  8   ext. 10 kΩ pull-down to GND
    //   GPA6 (idx  6) → C1  → IDC  7   ext. 10 kΩ pull-down to GND
    //   GPA5 (idx  5) → C2  → IDC  6   ext. 10 kΩ pull-down to GND
    //   GPB0 (idx  8) → C3  → IDC  9   ext. 10 kΩ pull-down to GND
    //   GPA0 (idx  0) → C4  → IDC  1   ext. 10 kΩ pull-down to GND
    //   GPA2 (idx  2) → C5  → IDC  3   ext. 10 kΩ pull-down to GND
    //   GPB1 (idx  9) → C6  → IDC 10   ext. 10 kΩ pull-down to GND
    //   GPA1 (idx  1) → C7  → IDC  2   ext. 10 kΩ pull-down to GND
    //   GPA4 (idx  4) → C8  → IDC  5   ext. 10 kΩ pull-down to GND
    //   GPA3 (idx  3) → C9  → IDC  4   ext. 10 kΩ pull-down to GND
    //   GPB3 (idx 11) → C10 → IDC 14   ext. 10 kΩ pull-down to GND
    //   GPB4 (idx 12) → C11 → IDC 15   ext. 10 kΩ pull-down to GND
    //   GPB7 (idx 15) → C13 → IDC 24   ext. 10 kΩ pull-down to GND
    //   GPB2 (idx 10) → C14 → IDC 13   ext. 10 kΩ pull-down to GND
    //   GPB5 (idx 13) → C16 → IDC 20   ext. 10 kΩ pull-down to GND
    //   GPB6 (idx 14) → C17 → IDC 23   ext. 10 kΩ pull-down to GND
    //   INTB → D5/P0.24  (4.7 kΩ ext. pull-up to 3.3V; IOCON.MIRROR=1 routes INTA+INTB → one wire)
    //
    // MCP23017 (0x21) — &mcp23017_21  (rows R0–R7, GPB only — output-only chip):
    //   GPA0–7 (idx  0–7)  → n/c  (unused)
    //   GPB0 (idx  8) → R0 → IDC 11   active-high driven output
    //   GPB1 (idx  9) → R1 → IDC 12   active-high driven output
    //   GPB2 (idx 10) → R2 → IDC 16   active-high driven output
    //   GPB3 (idx 11) → R3 → IDC 17   active-high driven output
    //   GPB4 (idx 12) → R4 → IDC 18   active-high driven output
    //   GPB5 (idx 13) → R5 → IDC 19   active-high driven output
    //   GPB6 (idx 14) → R6 → IDC 21   active-high driven output
    //   GPB7 (idx 15) → R7 → IDC 22   active-high driven output
    //   No int-gpios (output-only chip — row drives never trigger column interrupts)
    //
    // nRF52840 direct GPIO (col inputs — ext. 10 kΩ pull-down + nRF internal pull-down):
    //   D6  / P1.00 (gpio1 pin  0) → C12 → IDC 25
    //   D10 / P0.09 (gpio0 pin  9) → C15 → IDC 26
    // -------------------------------------------------------------------------
    kscan: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        diode-direction = "row2col";
        wakeup-source;
        // debounce-press-ms = <10>;
        // debounce-release-ms = <10>;

        col-gpios
            = <&mcp23017_20  7 GPIO_ACTIVE_HIGH>  /* C0  - IDC pin  8  MCP0.GPA7 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  6 GPIO_ACTIVE_HIGH>  /* C1  - IDC pin  7  MCP0.GPA6 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  5 GPIO_ACTIVE_HIGH>  /* C2  - IDC pin  6  MCP0.GPA5 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  8 GPIO_ACTIVE_HIGH>  /* C3  - IDC pin  9  MCP0.GPB0 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  0 GPIO_ACTIVE_HIGH>  /* C4  - IDC pin  1  MCP0.GPA0 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  2 GPIO_ACTIVE_HIGH>  /* C5  - IDC pin  3  MCP0.GPA2 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  9 GPIO_ACTIVE_HIGH>  /* C6  - IDC pin 10  MCP0.GPB1 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  1 GPIO_ACTIVE_HIGH>  /* C7  - IDC pin  2  MCP0.GPA1 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  4 GPIO_ACTIVE_HIGH>  /* C8  - IDC pin  5  MCP0.GPA4 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20  3 GPIO_ACTIVE_HIGH>  /* C9  - IDC pin  4  MCP0.GPA3 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20 11 GPIO_ACTIVE_HIGH>  /* C10 - IDC pin 14  MCP0.GPB3 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20 12 GPIO_ACTIVE_HIGH>  /* C11 - IDC pin 15  MCP0.GPB4 — ext. 10 kΩ pull-down to GND */
            , <&gpio1 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* C12 - IDC pin 25  D6/P1.00  — ext. 10 kΩ pull-down to GND (nRF internal pull-down also present) */
            , <&mcp23017_20 15 GPIO_ACTIVE_HIGH>  /* C13 - IDC pin 24  MCP0.GPB7 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20 10 GPIO_ACTIVE_HIGH>  /* C14 - IDC pin 13  MCP0.GPB2 — ext. 10 kΩ pull-down to GND */
            , <&gpio0 9 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* C15 - IDC pin 26  D10/P0.09 — ext. 10 kΩ pull-down to GND (nRF internal pull-down also present) */
            , <&mcp23017_20 13 GPIO_ACTIVE_HIGH>  /* C16 - IDC pin 20  MCP0.GPB5 — ext. 10 kΩ pull-down to GND */
            , <&mcp23017_20 14 GPIO_ACTIVE_HIGH>  /* C17 - IDC pin 23  MCP0.GPB6 — ext. 10 kΩ pull-down to GND */
            ;

        row-gpios
            = <&mcp23017_21  8 GPIO_ACTIVE_HIGH>  /* R0 - IDC pin 11  MCP1.GPB0 — active-high driven output */
            , <&mcp23017_21  9 GPIO_ACTIVE_HIGH>  /* R1 - IDC pin 12  MCP1.GPB1 — active-high driven output */
            , <&mcp23017_21 10 GPIO_ACTIVE_HIGH>  /* R2 - IDC pin 16  MCP1.GPB2 — active-high driven output */
            , <&mcp23017_21 11 GPIO_ACTIVE_HIGH>  /* R3 - IDC pin 17  MCP1.GPB3 — active-high driven output */
            , <&mcp23017_21 12 GPIO_ACTIVE_HIGH>  /* R4 - IDC pin 18  MCP1.GPB4 — active-high driven output */
            , <&mcp23017_21 13 GPIO_ACTIVE_HIGH>  /* R5 - IDC pin 19  MCP1.GPB5 — active-high driven output */
            , <&mcp23017_21 14 GPIO_ACTIVE_HIGH>  /* R6 - IDC pin 21  MCP1.GPB6 — active-high driven output */
            , <&mcp23017_21 15 GPIO_ACTIVE_HIGH>  /* R7 - IDC pin 22  MCP1.GPB7 — active-high driven output */
            ;
    };

    // -------------------------------------------------------------------------
    // Matrix transform — 18 columns × 8 rows, 104 keys
    //
    // RC(row, col):
    //   col = index into col-gpios list above (0 = C0 … 17 = C17)
    //   row = index into row-gpios list above (0 = R0 … 7  = R7)
    //
    // Columns (col index):
    //   C0 (0) : ESC ` Tab 1 Q A Z
    //   C1 (1) : F1 2 W S X CapsLk
    //   C2 (2) : F2 F3 F4 3 E D C
    //   C3 (3) : F5 Pause LCtrl RCtrl
    //   C4 (4) : F6 8 I K , =+ ]}
    //   C5 (5) : F7 F8 9 O L . Apps
    //   C6 (6) : F9 F10 F11 F12 BkSpc \ Enter
    //   C7 (7) : PrtSc ScLk LAlt RAlt
    //   C8 (8) : 4 5 R T F G V B
    //   C9 (9) : 6 7 Y U H J N M
    //   C10(10): 0 - P [{ ' ; /?
    //   C11(11): Space NumLk Num7 Num4 Num1 Down Del
    //   C12(12): LShft RShft
    //   C13(13): LWin
    //   C14(14): Ins Right Num0 Num2 Num5 Num8 Num/
    //   C15(15): Home End Up Left Num+ NumEnt
    //   C16(16): PgUp PgDn Num* Num9 Num6 Num3 Num. Num-
    //   C17(17): RWin
    //
    // Rows (row index):
    //   R0(0): ESC F4 F6 F11 LAlt Space H G ' Up Num0 Num.
    //   R1(1): PrtSc F10 0 9 8 7 F5 4 3 2 1 PgDn End
    //   R2(2): PgUp Home Del Ins =+ -_ F9 F8 6 5 F2 F1 ` LCtrl
    //   R3(3): NumEnt Num3 Num2 Num1 RShft RWin \ ; L K J F D S A
    //   R4(4): Num5 Num6 Num4 BkSpc ]} [{ F7 T Y F3 Tab CapsLk LShft LWin
    //   R5(5): Num9 Num+ Num8 Num7 Pause ScLk P O I U R E W Q
    //   R6(6): Num/ NumLk Num* RCtrl V C X Z M , . Enter
    //   R7(7): Num- Right Down Left Apps /? RAlt N B F12
    // -------------------------------------------------------------------------
    default_transform: default_transform {
         compatible = "zmk,matrix-transform";
         columns = <18>;
         rows = <8>;

         map = <
        // ── R0: C0      C1       C2       C3       C4       C5       C6       C7       C8       C9       C10      C11      C12      C13      C14      C15      C16      C17
        //       ESC      -        F4       -        F6       -        F11      LAlt     G        H        '        Space    -        -        KP0      Up       KP.      -
           RC(0,0)  RC(0,1)  RC(0,2)  RC(0,3)  RC(0,4)  RC(0,5)  RC(0,6)  RC(0,7)  RC(0,8)  RC(0,9)  RC(0,10) RC(0,11) RC(0,12) RC(0,13) RC(0,14) RC(0,15) RC(0,16) RC(0,17)
        // ── R1: N1       N2       N3       F5       N8       N9       F10      PrtSc    N4       N7       N0       -        -        -        -        End      PgDn     -
           RC(1,0)  RC(1,1)  RC(1,2)  RC(1,3)  RC(1,4)  RC(1,5)  RC(1,6)  RC(1,7)  RC(1,8)  RC(1,9)  RC(1,10) RC(1,11) RC(1,12) RC(1,13) RC(1,14) RC(1,15) RC(1,16) RC(1,17)
        // ── R2: `        F1       F2       LCtrl    =        F8       F9       -        N5       N6       -        Del      -        -        Ins      Home     PgUp     -
           RC(2,0)  RC(2,1)  RC(2,2)  RC(2,3)  RC(2,4)  RC(2,5)  RC(2,6)  RC(2,7)  RC(2,8)  RC(2,9)  RC(2,10) RC(2,11) RC(2,12) RC(2,13) RC(2,14) RC(2,15) RC(2,16) RC(2,17)
        // ── R3: A        S        D        -        K        L        \        -        F        J        ;        KP1      RShft    -        KP2      KPEnt    KP3      RWin
           RC(3,0)  RC(3,1)  RC(3,2)  RC(3,3)  RC(3,4)  RC(3,5)  RC(3,6)  RC(3,7)  RC(3,8)  RC(3,9)  RC(3,10) RC(3,11) RC(3,12) RC(3,13) RC(3,14) RC(3,15) RC(3,16) RC(3,17)
        // ── R4: Tab      Caps     F3       -        ]}       F7       BkSp     -        T        Y        [{       KP4      LShft    LWin     KP5      -        KP6      -
           RC(4,0)  RC(4,1)  RC(4,2)  RC(4,3)  RC(4,4)  RC(4,5)  RC(4,6)  RC(4,7)  RC(4,8)  RC(4,9)  RC(4,10) RC(4,11) RC(4,12) RC(4,13) RC(4,14) RC(4,15) RC(4,16) RC(4,17)
        // ── R5: Q        W        E        Pause    I        O        -        ScLk     R        U        P        KP7      -        -        KP8      KP+      KP9      -
           RC(5,0)  RC(5,1)  RC(5,2)  RC(5,3)  RC(5,4)  RC(5,5)  RC(5,6)  RC(5,7)  RC(5,8)  RC(5,9)  RC(5,10) RC(5,11) RC(5,12) RC(5,13) RC(5,14) RC(5,15) RC(5,16) RC(5,17)
        // ── R6: Z        X        C        RCtrl    ,        .        Enter    -        V        M        -        NumLk    -        -        KP/      -        KP*      -
           RC(6,0)  RC(6,1)  RC(6,2)  RC(6,3)  RC(6,4)  RC(6,5)  RC(6,6)  RC(6,7)  RC(6,8)  RC(6,9)  RC(6,10) RC(6,11) RC(6,12) RC(6,13) RC(6,14) RC(6,15) RC(6,16) RC(6,17)
        // ── R7: -        -        -        -        -        Apps     F12      RAlt     B        N        /?       Down     -        -        Right    Left     KP-      -
           RC(7,0)  RC(7,1)  RC(7,2)  RC(7,3)  RC(7,4)  RC(7,5)  RC(7,6)  RC(7,7)  RC(7,8)  RC(7,9)  RC(7,10) RC(7,11) RC(7,12) RC(7,13) RC(7,14) RC(7,15) RC(7,16) RC(7,17)
        >;
    };

    // -------------------------------------------------------------------------
    // HID lock-state indicator LEDs
    //
    // Wiring: 3.3V → 470Ω → LED → nRF52840 GPIO (current-sink).
    // GPIO LOW = LED ON  →  GPIO_ACTIVE_LOW.
    //
    //   Num Lock    → D7  / P0.11  (gpio0 pin 11)
    //   Caps Lock   → D8  / P1.04  (gpio1 pin  4)
    //   Scroll Lock → D9  / P1.06  (gpio1 pin  6)
    //
    // New ZMK API: zmk,indicator-leds node (zmk/app/dts/bindings/indicators/)
    // Each child maps a gpio-leds child phandle → HID_INDICATOR_* constant.
    // ZMK_INDICATOR_LEDS Kconfig is auto-enabled by DT_HAS_ZMK_INDICATOR_LEDS_ENABLED
    // when this node exists; CONFIG_ZMK_HID_INDICATORS=y is still required in .conf.
    // -------------------------------------------------------------------------
    leds {
        compatible = "gpio-leds";
        led_num_lock: led_num_lock {
            gpios = <&gpio0 11 GPIO_ACTIVE_LOW>;  /* D7  / P0.11 — 3.3V→470Ω→LED→GPIO */
        };
        led_caps_lock: led_caps_lock {
            gpios = <&gpio1 4 GPIO_ACTIVE_LOW>;   /* D8  / P1.04 — 3.3V→470Ω→LED→GPIO */
        };
        led_scroll_lock: led_scroll_lock {
            gpios = <&gpio1 6 GPIO_ACTIVE_LOW>;   /* D9  / P1.06 — 3.3V→470Ω→LED→GPIO */
        };
    };

    indicators {
        compatible = "zmk,indicator-leds";
        on-when-idle;

        num_lock_indicator {
            leds = <&led_num_lock>;
            indicator = <HID_INDICATOR_NUM_LOCK>;
        };
        caps_lock_indicator {
            leds = <&led_caps_lock>;
            indicator = <HID_INDICATOR_CAPS_LOCK>;   
        };
        scroll_lock_indicator {
            leds = <&led_scroll_lock>;
            indicator = <HID_INDICATOR_SCROLL_LOCK>;
        };
    };

    // -------------------------------------------------------------------------
    // Bootloader integration
    //
    // 1. Physical boot button — wire a momentary switch between P0.22 (Pro
    //    Micro D4) and GND.  In the keymap bind a combo to &bootloader.
    //    Change the GPIO if a different pin is physically connected.
    //
    // 2. Soft power-off waker — lets the keyboard matrix wake the MCU from
    //    ZMK software power-off (CONFIG_ZMK_PM_SOFT_OFF=y).  Required for
    //    the BLE sleep/wake cycle on battery-powered builds.
    // -------------------------------------------------------------------------
    boot_button: boot_button {
        compatible = "gpio-keys";
        status = "okay";
        boot_key: boot_key {
            label = "Bootloader Key";
            gpios = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        };
    };

    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan>;
    };
};

// -------------------------------------------------------------------------
// I²C bus — MCP23017 GPIO expanders, OLED, fuel gauge
//
// Pin assignment (nice_nano_v2 Pro Micro footprint):
//   SDA  →  P0.17  (Pro Micro D2)   — defined in board's i2c0_default pinctrl
//   SCL  →  P0.20  (Pro Micro D3)   — defined in board's i2c0_default pinctrl
//
// If using a custom nRF52840 board that does NOT pre-define i2c0_default,
// add a &pinctrl block here:
//
//   #include <dt-bindings/pinctrl/nrf-pinctrl.h>
//   &pinctrl {
//       i2c0_default: i2c0_default {
//           group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
//                            <NRF_PSEL(TWIM_SCL, 0, 20)>; bias-pull-up; }; };
//       i2c0_sleep: i2c0_sleep {
//           group1 { psels = <NRF_PSEL(TWIM_SDA, 0, 17)>,
//                            <NRF_PSEL(TWIM_SCL, 0, 20)>; low-power-enable; }; };
//   };
//
// Bus devices:  mcp23017@20, mcp23017@21, ssd1306@3c (128×32), max17048@36
// 4.7 kΩ pull-ups on SDA/SCL to 3.3 V required on the PCB (also re-enables OLED).
//
// MCP23017 interrupt wiring — one dedicated INT line per chip:
//
//   Each chip: IOCON.MIRROR=1 (INTA mirrors INTB, full 16-pin coverage from one pin)
//              IOCON.ODR=1    (open-drain INT output)
//   Fit one 4.7 kΩ pull-up resistor from each INT line to 3.3 V on the PCB.
//   The nRF52840 GPIO is configured without an internal pull-up (GPIO_ACTIVE_LOW only).
//
//   mcp23017@20  INTB ──── D5  / P0.24  (gpio0 pin 24)  — 4.7kΩ ext. pull-up to 3.3V on PCB
//   mcp23017@21  No INT line — output-only row driver; D6/P1.00 used for C12 nRF direct GPIO
//
//   MCP0 all 16 pins are col inputs (scrambled routing, see kscan comment block).
//   MCP0 INT fires when any col input goes HIGH (key press through diode, row held HIGH).
//   MCP1 GPB0-7 are driven outputs (row scan) — no interrupt needed on MCP1.
//
// MAX17048 ALRT interrupt wiring:
//   ALRT pin is open-drain, active-low.
//   The Adafruit MAX17048 STEMMA QT breakout already has a 10 kΩ pull-up to VIN onboard —
//   no external pull-up resistor is needed on the perfboard.
//   Connect ALRT → D0 / P0.08  (gpio0 pin 8).
//   GPIO_PULL_UP is kept as belt-and-suspenders; nRF internal ~13 kΩ || 10 kΩ = ~5.6 kΩ, fine.
//   alert-low-percent-threshold: 4  → ALRT fires below 4% SoC (register CONFIG[7:0]).
// -------------------------------------------------------------------------
&i2c0 {
    status = "okay";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <400000>;   /* 400 kHz fast-mode — 4 devices, keep bus fast */

    mcp23017_20: mcp23017@20 {
        compatible = "microchip,mcp23017";
        reg = <0x20>;
        gpio-controller;
        #gpio-cells = <2>;
        int-gpios = <&gpio0 24 GPIO_ACTIVE_LOW>;  /* INTB → D5/P0.24; 4.7 kΩ ext. pull-up to 3.3V */
        /* MCP0 col inputs — scrambled routing to match IDC physical wiring:
         *   GPA7(7)=C0(IDC8)  GPA6(6)=C1(IDC7)  GPA5(5)=C2(IDC6)  GPB0(8)=C3(IDC9)
         *   GPA0(0)=C4(IDC1)  GPA2(2)=C5(IDC3)  GPB1(9)=C6(IDC10) GPA1(1)=C7(IDC2)
         *   GPA4(4)=C8(IDC5)  GPA3(3)=C9(IDC4)  GPB3(11)=C10(IDC14) GPB4(12)=C11(IDC15)
         *   GPB7(15)=C13(IDC24) GPB2(10)=C14(IDC13) GPB5(13)=C16(IDC20) GPB6(14)=C17(IDC23)
         * C12(IDC25) and C15(IDC26) wired directly to nRF GPIO (gpio1 pin0, gpio0 pin9).
         * All MCP0 pins: ext. 10 kΩ pull-down to GND; IOCON.MIRROR=1; INTB→D5/P0.24.
         * A2=0 A1=0 A0=0 → 0x20 */
    };

    mcp23017_21: mcp23017@21 {
        compatible = "microchip,mcp23017";
        reg = <0x21>;
        gpio-controller;
        #gpio-cells = <2>;
        /* MCP1 GPB0-7 = row outputs R0-R7 (IDC pins 11,12,16,17,18,19,21,22)
         * MCP1 GPA0-7 = n/c (unused)
         * Output-only chip — no INT line needed. D6/P1.00 used for C12 (nRF direct GPIO).
         * A2=0 A1=0 A0=1 → 0x21 */
    };

   ssd1306: ssd1306@3c {
      compatible = "solomon,ssd1306fb";
      status = "disabled";     /* TEMPORARILY DISABLED — OLED physically disconnected */
      reg = <0x3c>;
        width = <128>;
        height = <32>;
        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <31>;  /* 32 rows − 1 */
        prechargep = <0x22>;
        com-invdir;              /* COM scan direction: remapped (top→bottom for
                                    DFRobot Fermion 0.91″ module)              */
    };

   max17048: max17048@36 {
      compatible = "zmk,maxim-max17048";
      status = "disabled";     /* TEMPORARILY DISABLED — MAX17048 physically disconnected */
      reg = <0x36>;
        /* ALRT open-drain → D0/P0.08.
         * Adafruit STEMMA QT board has 10 kΩ pull-up to VIN onboard — no external resistor needed.
         * GPIO_PULL_UP kept as belt-and-suspenders (nRF ~13 kΩ || board 10 kΩ = ~5.6 kΩ).
         * alert-low-percent-threshold configures the CONFIG register ATHD field.
         * The driver sets ATHD so ALRT fires below the threshold, then clears
         * STATUS.EnVR on re-read so the open-drain line deasserts.            */
        // alert-gpios = <&gpio0 8 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        // alert-low-percent-threshold = <4>;
    };
};
